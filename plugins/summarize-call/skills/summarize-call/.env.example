# Granola public API key. Generate one in Granola → Settings → API, then copy
# this file to `.env` (gitignored) and paste your key below.
#   cp .env.example .env
# The key looks like grn_xxxxxxxxxxxxxxxxxxxx and grants read access to your
# own notes. granola.py prefers this over the desktop token, so once it's set
# the skill no longer needs the Granola desktop app's local credential store.
GRANOLA_API_KEY=
