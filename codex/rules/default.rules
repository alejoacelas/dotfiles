prefix_rule(pattern=["npm", "search"], decision="allow")
prefix_rule(pattern=["curl", "-L"], decision="allow")
prefix_rule(pattern=["python3", "-m", "http.server"], decision="allow")
prefix_rule(pattern=["curl"], decision="allow")
prefix_rule(pattern=["python3", ".claude/skills/summarize-call/scripts/granola.py"], decision="allow")
prefix_rule(pattern=["gdoc"], decision="allow")
prefix_rule(pattern=["git", "add"], decision="allow")
prefix_rule(pattern=["git", "commit"], decision="allow")
prefix_rule(pattern=["git", "fetch"], decision="allow")
prefix_rule(pattern=["git", "push"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "UV_CACHE_DIR=/tmp/uv-content-update-cache uv run --with pypandoc python -c 'import pypandoc,sys; pypandoc.convert_file(sys.argv[1], \"docx\", outputfile=sys.argv[2], extra_args=[\"--standalone\"])' /tmp/content-update-report.Rzflfp/report.md /tmp/content-update-report.Rzflfp/content-update-review.docx"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "UV_CACHE_DIR=/tmp/uv-content-update-cache uv run --with pypandoc_binary python -c 'import pypandoc,sys; pypandoc.convert_file(sys.argv[1], \"docx\", outputfile=sys.argv[2], extra_args=[\"--standalone\"])' /tmp/content-update-report.Rzflfp/report.md /tmp/content-update-report.Rzflfp/content-update-review.docx"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "UV_CACHE_DIR=/tmp/uv-content-update-cache uv run --with pytest pytest -q"], decision="allow")
prefix_rule(pattern=["ls", "-l", "/tmp/wp-sitemap.xml"], decision="allow")
