#!/usr/bin/env bash
# proj: create or reopen a dated project folder in ~/best, give it a GitHub repo and start an agent there.
# Usage: proj <name> [--claude|--codex] [--private|--local] [--repo-later]
#   proj                                         -> pick a project, newest first; type to fuzzy filter;
#                                                   inside an area (a top-level monorepo such as work/, areas/<x>, orgs/<company>) it lists
#                                                   that area's folders first and Ctrl-A widens to all of ~/best;
#                                                   Tab then an instruction runs claude -p there in the background
#                                                   (in desk when Tab comes before any filter text)
#   proj morning-notes --claude                  -> ~/best/projects/YYYY-MM-DD-morning-notes, public repo morning-notes;
#                                                   inside an area repo, <area>/YYYY-MM-DD-morning-notes with no new repo
#   proj orgs/impact-ops/status-tracker          -> ~/best/orgs/impact-ops/YYYY-MM-status-tracker, private repo
#   proj odd-idea --local                        -> no GitHub repo
#   proj odd-idea --repo-later                   -> the folder at once; the GitHub repo is made in the
#                                                   background (log in ~/.local/state/proj/repos)
#   proj --list [--here]                         -> the picker's list, one path per line relative to ~/best;
#                                                   --here puts the current area's folders first
# A name inside any repository (areas/dotfiles/x, areas/agent-tools/mac/x) is a plain dated folder, no repo.
# New folders get a first commit and a GitHub repo named <name>; the URL is printed.
# An existing folder whose name ends in -<name> is reopened instead, and its remote URL is printed.
# The proj shell function in shell/zprofile cds into the picked or created folder.
set -euo pipefail

usage() { sed -n '2,14s/^# \{0,1\}//p' "$0" >&2; exit 2; }

agent="" name="" visibility="" list="" here="" repo_later=""
for arg in "$@"; do
  case "$arg" in
    --list) list=1 ;;  # the picker's list (also the Ctrl-A reload)
    --here) here=1 ;;
    --repo-later) repo_later=1 ;;
    --claude) agent=claude ;;
    --codex) agent=codex ;;
    --private) visibility=private ;;
    --local) visibility=local ;;
    -h|--help) usage ;;
    -*) echo "proj: unknown option $arg" >&2; usage ;;
    *) [ -z "$name" ] || usage; name="$arg" ;;
  esac
done
best="$HOME/best"
self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"

# Top-level folders that are not areas themselves.
not_area='archive desk projects areas orgs'

# The area the shell is in: a top-level area folder such as work, or areas/<x> or
# orgs/<company>; empty elsewhere.
current_area() {
  local rel="${PWD#"$best"/}" a b
  [ "$rel" != "$PWD" ] || return 0
  IFS=/ read -r a b _ <<<"$rel"
  case "$a" in
    areas|orgs) [ -n "$b" ] && echo "$a/$b" ;;
    archive|desk|projects) ;;
    *) echo "$a" ;;
  esac
}

# Pickable folders as "<creation date> <creation time> <path>". With an area, that area's folders;
# otherwise everything in projects/, areas/, orgs/<company>/ and the top-level areas, plus desk.
# BSD stat and date on macOS, GNU on Linux.
pickable_folders() {
  local gnu=""; stat -c %W / >/dev/null 2>&1 && gnu=1
  { if [ -n "${1:-}" ]; then
      find "$best/$1" -mindepth 1 -maxdepth 1 -type d ! -name '.*' ! -name node_modules
    else
      local tops=() t
      for t in "$best"/*/; do t="${t%/}"; case " $not_area " in *" ${t##*/} "*) ;; *) tops+=("$t") ;; esac; done
      find "$best/projects" "$best/areas" "$best"/orgs/* "${tops[@]}" -mindepth 1 -maxdepth 1 -type d ! -name '.*'
      echo "$best/desk"
    fi; } | while IFS= read -r dir; do
    if [ -n "$gnu" ]; then t="$(stat -c %W "$dir")"; d="$(date -d "@$t" +%F)"
    else t="$(stat -f %B "$dir")"; d="$(date -r "$t" +%F)"; fi
    echo "$d $t $dir"
  done
}

# Start an unsupervised claude -p session in $1 with instruction $2, detached from this terminal.
run_in_background() {
  local dir="$1" instruction="$2" logs="${XDG_STATE_HOME:-$HOME/.local/state}/proj/runs"
  mkdir -p "$logs"
  local log="$logs/$(date +%Y-%m-%d-%H%M%S)-$(basename "$dir").log"
  printf 'dir: %s\ninstruction: %s\n\n' "$dir" "$instruction" > "$log"
  (cd "$dir" && nohup claude -p --dangerously-skip-permissions "$instruction" </dev/null >>"$log" 2>&1 &)
  echo "Started claude in $dir" >&2
  echo "Log: $log" >&2
}

# List paths relative to ~/best, newest first by the date in the folder name (month-only
# folders count as day 00; undated folders use their creation date), then by creation time.
sorted_folders() {
  pickable_folders "${1:-}" | sed "s|$best/||" |
    awk '{ n = split($3, p, "/"); d = substr(p[n], 1, 10)
           if (d !~ /^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) d = (d ~ /^[0-9]{4}-[0-9]{2}-/) ? substr(d, 1, 7) "-00" : $1
           print d, $2, $3 }' |
    sort -k1,1r -k2,2nr | cut -d' ' -f3-
}

if [ -n "$list" ]; then
  if [ -n "$here" ]; then
    area="$(current_area)"
    { [ -z "$area" ] || sorted_folders "$area"; sorted_folders; } | awk '!seen[$0]++'
  else
    sorted_folders "$name"
  fi
  exit 0
fi

if [ -z "$name" ]; then
  [ -z "$agent$visibility" ] || usage
  command -v fzf >/dev/null || { echo "proj: picking a project needs fzf (brew install fzf)" >&2; exit 1; }
  # Inside an area, start with its folders; Ctrl-A reloads the list with all of ~/best.
  # Typing ranks fuzzy matches; equal matches keep that order.
  area="$(current_area)"
  all_header='enter: open  tab: run claude in the background (in desk if nothing typed)'
  header="$all_header"
  [ -z "$area" ] || header="in $area  ctrl-a: all of ~/best  $all_header"
  out="$(sorted_folders "$area" |
    fzf --height=40% --reverse --scheme=path --tiebreak=index --prompt='project> ' \
      --print-query --expect=tab \
      --bind "ctrl-a:reload('$self' --list)+change-header($all_header)" \
      --header="$header")" || exit 1
  query="$(sed -n 1p <<<"$out")" key="$(sed -n 2p <<<"$out")" picked="$(sed -n 3p <<<"$out")"
  if [ "$key" = tab ]; then
    [ -n "$query" ] || picked=desk
    printf 'instruction for claude in %s> ' "$picked" >&2
    IFS= read -r -e instruction </dev/tty
    [ -n "$instruction" ] || { echo "proj: empty instruction, nothing started" >&2; exit 1; }
    run_in_background "$best/$picked" "$instruction"
    exit 0
  fi
  echo "$best/$picked"
  exit 0
fi

# A bare name goes into the current area, or into projects/ outside one.
area="$(current_area)"
case "$name" in
  */*) parent="$best/${name%/*}"; slug="${name##*/}" ;;
  *) parent="$best/${area:-projects}"; slug="$name" ;;
esac
# A folder inside a repository (an area that is a repository, or any folder in one) holds its
# entries as plain folders, with no repo of their own.
monorepo=""
[ "$(git -C "$parent" rev-parse --is-inside-work-tree 2>/dev/null)" = true ] && monorepo=1
# Own projects and area entries are dated to the day; client projects, trials and the rest use the month.
date_format=%Y-%m
[ "$parent" = "$best/projects" ] || [ -n "$monorepo" ] && date_format=%Y-%m-%d
slug="$(printf '%s' "$slug" | tr '[:upper:] _' '[:lower:]--' | tr -cd 'a-z0-9-')"
[ -n "$slug" ] || { echo "proj: name must contain letters or digits" >&2; exit 2; }
# Client work under orgs/ is private; everything else is public unless told otherwise.
if [ -z "$visibility" ]; then
  case "$parent/" in
    "$best/orgs/"*) visibility=private ;;
    *) visibility=public ;;
  esac
fi

existing="$(find "$parent" -maxdepth 1 -type d \( -name "[0-9][0-9][0-9][0-9]-[0-9][0-9]-$slug" \
  -o -name "[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-$slug" \) 2>/dev/null | sort | tail -1)"
if [ -n "$existing" ]; then
  dir="$existing"
  echo "Reopening $dir"
  if url="$(git -C "$dir" remote get-url origin 2>/dev/null)"; then echo "${url%.git}"; fi
elif [ -d "$parent/template" ] && git -C "$parent" rev-parse -q --is-inside-work-tree >/dev/null 2>&1; then
  # A folder inside a repository with a template, such as projects/2026-10-08-trials/: copy it, no new repo.
  dir="$parent/$(date +"$date_format")-$slug"
  cp -R "$parent/template" "$dir"
  echo "Created $dir from template"
elif [ -n "$monorepo" ]; then
  dir="$parent/$(date +"$date_format")-$slug"
  mkdir -p "$dir"
  echo "Created $dir"
else
  dir="$parent/$(date +"$date_format")-$slug"
  if [ "$visibility" != local ] && [ -z "$repo_later" ]; then
    # Check the repo name before creating anything, so a taken name leaves no half-made folder.
    owner="$(gh api user --jq .login)"
    if out="$(gh api "repos/$owner/$slug" --jq .html_url 2>&1)"; then
      echo "proj: $out already exists; pick another name" >&2; exit 1
    elif ! grep -q "Not Found" <<<"$out"; then
      echo "proj: could not check GitHub: $out" >&2; exit 1
    fi
  fi
  mkdir -p "$dir"
  git -C "$dir" init -q -b main
  cat > "$dir/AGENTS.md" <<AGENTS
# $slug

Scope: TODO

- Visibility: $visibility
- Still running or billing: none
AGENTS
  git -C "$dir" add AGENTS.md
  git -C "$dir" commit -q -m "Start $slug"
  echo "Created $dir"
  if [ "$visibility" != local ] && [ -n "$repo_later" ]; then
    # The repo comes later: a taken name leaves the folder without a remote, said in the log and a
    # notification.
    logs="${XDG_STATE_HOME:-$HOME/.local/state}/proj/repos"; mkdir -p "$logs"
    log="$logs/$(date +%Y-%m-%d-%H%M%S)-$slug.log"
    (
      set +e
      if owner="$(gh api user --jq .login)" && ! gh api "repos/$owner/$slug" >/dev/null 2>&1 &&
         gh repo create "$owner/$slug" "--$visibility" --source "$dir" --push >/dev/null; then
        echo "created $(git -C "$dir" remote get-url origin)"
      else
        echo "proj: no GitHub repo for $dir (name taken or gh failed); run gh repo create yourself"
        osascript -e "display notification \"No GitHub repo for $slug: see $log\" with title \"proj\"" 2>/dev/null
      fi
    ) </dev/null >"$log" 2>&1 &
    echo "GitHub repo $slug: being created in the background (log: $log)"
  elif [ "$visibility" != local ]; then
    gh repo create "$owner/$slug" "--$visibility" --source "$dir" --push >/dev/null
    url="$(git -C "$dir" remote get-url origin)"
    echo "${url%.git}"
  fi
fi

cd "$dir"
# The proj shell function cds here afterwards.
[ -z "${PROJ_CD_FILE:-}" ] || echo "$dir" > "$PROJ_CD_FILE"
case "$agent" in
  claude) exec claude --dangerously-skip-permissions ;;
  codex) exec codex --dangerously-bypass-approvals-and-sandbox ;;
esac
