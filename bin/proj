#!/usr/bin/env bash
# proj: create or reopen a dated project folder in ~/best and start an agent there.
# Usage: proj <name> [--claude|--codex] [--local] [--repo-later]
#   proj                                  -> pick a folder, newest first; type to fuzzy filter;
#                                            inside an area (work, personal, systems or orgs/<org>) it lists
#                                            that area's folders first and Ctrl-A widens to all of ~/best;
#                                            Tab then an instruction runs claude -p there in the background
#                                            (in systems/desk when Tab comes before any filter text)
#   proj morning-notes --claude           -> inside an area, <area>/projects/YYYY-MM-DD-morning-notes;
#                                            from ~/best itself it asks which area (work, personal, systems)
#   proj work/morning-notes               -> work/projects/YYYY-MM-DD-morning-notes, from anywhere
#   proj orgs/impact-ops/status-tracker   -> orgs/impact-ops/YYYY-MM-status-tracker in that org's repo;
#                                            a new org gets its own private GitHub repo orgs-<org>
#   proj orgs/new-org/x --local           -> the new org's repo stays local, with no GitHub repo
#   proj orgs/new-org/x --repo-later      -> the folder at once; the org's GitHub repo is made in the
#                                            background (log in ~/.local/state/proj/repos)
#   proj --list [--here]                  -> the picker's list, one path per line relative to ~/best;
#                                            --here puts the current area's folders first
# Any other path (systems/dotfiles/x, work/projects/x) is a plain dated folder in that folder.
# Folders are plain folders in their area's repository; only a new org gets a new repo.
# An existing folder whose name ends in -<name> is reopened instead, and its remote URL is printed.
# The proj shell function in shell/zprofile cds into the picked or created folder.
set -euo pipefail

usage() { sed -n '2,22s/^# \{0,1\}//p' "$0" >&2; exit 2; }

agent="" name="" local_only="" list="" here="" repo_later=""
for arg in "$@"; do
  case "$arg" in
    --list) list=1 ;;  # the picker's list (also the Ctrl-A reload)
    --here) here=1 ;;
    --repo-later) repo_later=1 ;;
    --claude) agent=claude ;;
    --codex) agent=codex ;;
    --local) local_only=1 ;;
    -h|--help) usage ;;
    -*) echo "proj: unknown option $arg" >&2; usage ;;
    *) [ -z "$name" ] || usage; name="$arg" ;;
  esac
done
best="$HOME/best"
self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"

# The areas: each holds undated ongoing folders plus projects/YYYY-MM-DD-name one-offs.
areas='work personal systems'
is_area() { case " $areas " in *" $1 "*) return 0 ;; esac; return 1; }

# The area the shell is in: work, personal, systems or orgs/<org>; empty elsewhere.
current_area() {
  local rel="${PWD#"$best"/}" a b
  [ "$rel" != "$PWD" ] || return 0
  IFS=/ read -r a b _ <<<"$rel"
  if is_area "$a"; then echo "$a"
  elif [ "$a" = orgs ] && [ -n "$b" ]; then echo "orgs/$b"
  fi
}

# The folders the picker offers inside root $1 (relative to ~/best): an area's children and its
# projects/ children; an org's children; any other folder's children. With no root, every area's
# folders plus the orgs and their folders.
candidate_folders() {
  local root="${1:-}" a
  if [ -z "$root" ]; then
    for a in $areas; do candidate_folders "$a"; done
    [ ! -d "$best/orgs" ] || find "$best/orgs" -mindepth 1 -maxdepth 2 -type d ! -name '.*' ! -name node_modules
  elif is_area "$root"; then
    [ ! -d "$best/$root" ] || find "$best/$root" -mindepth 1 -maxdepth 1 -type d ! -name '.*' ! -name node_modules ! -name projects
    [ ! -d "$best/$root/projects" ] || find "$best/$root/projects" -mindepth 1 -maxdepth 1 -type d ! -name '.*' ! -name node_modules
  else
    [ ! -d "$best/$root" ] || find "$best/$root" -mindepth 1 -maxdepth 1 -type d ! -name '.*' ! -name node_modules
  fi
}

# Pickable folders as "<creation date> <creation time> <path>". BSD stat and date on macOS, GNU on Linux.
pickable_folders() {
  local gnu=""; stat -c %W / >/dev/null 2>&1 && gnu=1
  candidate_folders "${1:-}" | while IFS= read -r dir; do
    if [ -n "$gnu" ]; then t="$(stat -c %W "$dir")"; d="$(date -d "@$t" +%F)"
    else t="$(stat -f %B "$dir")"; d="$(date -r "$t" +%F)"; fi
    echo "$d $t $dir"
  done
}

# Start an unsupervised claude -p session in $1 with instruction $2, detached from this terminal.
run_in_background() {
  local dir="$1" instruction="$2" logs="${XDG_STATE_HOME:-$HOME/.local/state}/proj/runs"
  mkdir -p "$logs"
  local log="$logs/$(date +%Y-%m-%d-%H%M%S)-$(basename "$dir").log"
  printf 'dir: %s\ninstruction: %s\n\n' "$dir" "$instruction" > "$log"
  (cd "$dir" && nohup claude -p --dangerously-skip-permissions "$instruction" </dev/null >>"$log" 2>&1 &)
  echo "Started claude in $dir" >&2
  echo "Log: $log" >&2
}

# List paths relative to ~/best, newest first by the date in the folder name (month-only
# folders count as day 00; undated folders use their creation date), then by creation time.
sorted_folders() {
  pickable_folders "${1:-}" | sed "s|$best/||" |
    awk '{ n = split($3, p, "/"); d = substr(p[n], 1, 10)
           if (d !~ /^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) d = (d ~ /^[0-9]{4}-[0-9]{2}-/) ? substr(d, 1, 7) "-00" : $1
           print d, $2, $3 }' |
    sort -k1,1r -k2,2nr | cut -d' ' -f3-
}

if [ -n "$list" ]; then
  if [ -n "$here" ]; then
    area="$(current_area)"
    { [ -z "$area" ] || sorted_folders "$area"; sorted_folders; } | awk '!seen[$0]++'
  else
    sorted_folders "$name"
  fi
  exit 0
fi

if [ -z "$name" ]; then
  [ -z "$agent$local_only$repo_later" ] || usage
  command -v fzf >/dev/null || { echo "proj: picking a project needs fzf (brew install fzf)" >&2; exit 1; }
  # Inside an area, start with its folders; Ctrl-A reloads the list with all of ~/best.
  # Typing ranks fuzzy matches; equal matches keep that order.
  area="$(current_area)"
  all_header='enter: open  tab: run claude in the background (in desk if nothing typed)'
  header="$all_header"
  [ -z "$area" ] || header="in $area  ctrl-a: all of ~/best  $all_header"
  out="$(sorted_folders "$area" |
    fzf --height=40% --reverse --scheme=path --tiebreak=index --prompt='project> ' \
      --print-query --expect=tab \
      --bind "ctrl-a:reload('$self' --list)+change-header($all_header)" \
      --header="$header")" || exit 1
  query="$(sed -n 1p <<<"$out")" key="$(sed -n 2p <<<"$out")" picked="$(sed -n 3p <<<"$out")"
  if [ "$key" = tab ]; then
    [ -n "$query" ] || picked=systems/desk
    printf 'instruction for claude in %s> ' "$picked" >&2
    IFS= read -r -e instruction </dev/tty
    [ -n "$instruction" ] || { echo "proj: empty instruction, nothing started" >&2; exit 1; }
    run_in_background "$best/$picked" "$instruction"
    exit 0
  fi
  echo "$best/$picked"
  exit 0
fi

# Ask which area a bare name typed outside every area goes into.
ask_area() {
  local answer
  { : </dev/tty; } 2>/dev/null || { echo "proj: not in an area; say <area>/$name (areas: $areas)" >&2; exit 2; }
  printf 'area for %s (work, personal, systems)> ' "$name" >&2
  IFS= read -r answer </dev/tty
  case "$answer" in
    w|work) echo work ;;
    p|personal) echo personal ;;
    s|systems) echo systems ;;
    *) echo "proj: no area $answer; nothing created" >&2; exit 2 ;;
  esac
}

# Where the folder goes: a bare name into the current area (asked for outside one); <area>/<name>
# into that area's projects/; orgs/<org>/<name> into that org; any other path into that folder.
org=""
case "$name" in
  orgs/*/*/*) parent="$best/${name%/*}"; slug="${name##*/}" ;;
  orgs/*/*) org="${name#orgs/}"; org="${org%%/*}"; parent="$best/orgs/$org"; slug="${name##*/}" ;;
  orgs/*) echo "proj: say orgs/<org>/<name>" >&2; exit 2 ;;
  */*) parent="$best/${name%/*}"; slug="${name##*/}"
       ! is_area "${name%/*}" || parent="$parent/projects" ;;
  *) area="$(current_area)"
     [ -n "$area" ] || area="$(ask_area)"
     case "$area" in orgs/*) org="${area#orgs/}"; parent="$best/$area" ;; *) parent="$best/$area/projects" ;; esac
     slug="$name" ;;
esac
slug="$(printf '%s' "$slug" | tr '[:upper:] _' '[:lower:]--' | tr -cd 'a-z0-9-')"
[ -n "$slug" ] || { echo "proj: name must contain letters or digits" >&2; exit 2; }
# Org folders are dated to the month; everything else to the day.
date_format=%Y-%m-%d
[ -z "$org" ] || date_format=%Y-%m

# A new org becomes its own repository with a private GitHub repo orgs-<org>.
if [ -n "$org" ] && { [ ! -d "$parent" ] ||
    [ "$(git -C "$parent" rev-parse --show-toplevel 2>/dev/null)" != "$(cd "$parent" && pwd -P)" ]; }; then
  org="$(printf '%s' "$org" | tr '[:upper:] _' '[:lower:]--' | tr -cd 'a-z0-9-')"
  parent="$best/orgs/$org" repo="orgs-$org"
  if [ -z "$local_only" ] && [ -z "$repo_later" ]; then
    # Check the repo name before creating anything, so a taken name leaves no half-made repo.
    owner="$(gh api user --jq .login)"
    if out="$(gh api "repos/$owner/$repo" --jq .html_url 2>&1)"; then
      echo "proj: $out already exists; clone it to $parent instead" >&2; exit 1
    elif ! grep -q "Not Found" <<<"$out"; then
      echo "proj: could not check GitHub: $out" >&2; exit 1
    fi
  fi
  mkdir -p "$parent"
  git -C "$parent" init -q -b main
  printf '.DS_Store\n.env\n.env.*\n.supervise/\n' > "$parent/.gitignore"
  git -C "$parent" add .gitignore
  git -C "$parent" commit -q -m "Start $repo"
  echo "Created org repo $parent"
  if [ -z "$local_only" ] && [ -n "$repo_later" ]; then
    # The repo comes later: a taken name leaves the org without a remote, said in the log and a
    # notification.
    logs="${XDG_STATE_HOME:-$HOME/.local/state}/proj/repos"; mkdir -p "$logs"
    log="$logs/$(date +%Y-%m-%d-%H%M%S)-$repo.log"
    (
      set +e
      if owner="$(gh api user --jq .login)" && ! gh api "repos/$owner/$repo" >/dev/null 2>&1 &&
         gh repo create "$owner/$repo" --private --source "$parent" --push >/dev/null; then
        echo "created $(git -C "$parent" remote get-url origin)"
      else
        echo "proj: no GitHub repo for $parent (name taken or gh failed); run gh repo create yourself"
        osascript -e "display notification \"No GitHub repo for $repo: see $log\" with title \"proj\"" 2>/dev/null
      fi
    ) </dev/null >"$log" 2>&1 &
    echo "GitHub repo $repo: being created in the background (log: $log)"
  elif [ -z "$local_only" ]; then
    gh repo create "$owner/$repo" --private --source "$parent" --push >/dev/null
    url="$(git -C "$parent" remote get-url origin)"
    echo "${url%.git}"
  fi
fi

case "$parent" in "$best/work/projects"|"$best/personal/projects"|"$best/systems/projects") mkdir -p "$parent" ;; esac
[ -d "$parent" ] || { echo "proj: no folder $parent" >&2; exit 1; }
existing="$(find "$parent" -maxdepth 1 -type d \( -name "[0-9][0-9][0-9][0-9]-[0-9][0-9]-$slug" \
  -o -name "[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-$slug" \) 2>/dev/null | sort | tail -1)"
if [ -n "$existing" ]; then
  dir="$existing"
  echo "Reopening $dir"
  if url="$(git -C "$dir" remote get-url origin 2>/dev/null)"; then echo "${url%.git}"; fi
elif [ -d "$parent/template" ]; then
  # A folder with a template, such as systems/projects/2026-10-08-trials/: copy it.
  dir="$parent/$(date +"$date_format")-$slug"
  cp -R "$parent/template" "$dir"
  echo "Created $dir from template"
else
  dir="$parent/$(date +"$date_format")-$slug"
  mkdir -p "$dir"
  echo "Created $dir"
fi

cd "$dir"
# The proj shell function cds here afterwards.
[ -z "${PROJ_CD_FILE:-}" ] || echo "$dir" > "$PROJ_CD_FILE"
case "$agent" in
  claude) exec claude --dangerously-skip-permissions ;;
  codex) exec codex --dangerously-bypass-approvals-and-sandbox ;;
esac
