#!/usr/bin/env bash
# proj: create or reopen a dated project folder in ~/best, give it a GitHub repo and start an agent there.
# Usage: proj <name> [--claude|--codex] [--private|--local]
#   proj                                         -> pick a project, newest first; type to fuzzy filter;
#                                                   Tab then an instruction runs claude -p there in the background
#   proj morning-notes --claude                  -> ~/best/projects/YYYY-MM-DD-morning-notes, public repo morning-notes
#   proj services/impact-ops/status-tracker      -> ~/best/services/impact-ops/YYYY-MM-status-tracker, private repo
#   proj odd-idea --local                        -> no GitHub repo
# New folders get a first commit and a GitHub repo named <name>; the URL is printed.
# An existing folder whose name ends in -<name> is reopened instead, and its remote URL is printed.
# The proj shell function in shell/zprofile cds into the picked project when no name is given.
set -euo pipefail

usage() { sed -n '2,10s/^# \{0,1\}//p' "$0" >&2; exit 2; }

agent="" name="" visibility=""
for arg in "$@"; do
  case "$arg" in
    --claude) agent=claude ;;
    --codex) agent=codex ;;
    --private) visibility=private ;;
    --local) visibility=local ;;
    -h|--help) usage ;;
    -*) echo "proj: unknown option $arg" >&2; usage ;;
    *) [ -z "$name" ] || usage; name="$arg" ;;
  esac
done
best="$HOME/best"

# Pickable folders as "<creation date> <creation time> <path>": everything in projects/, inbox/,
# stash/ and services/<company>/, plus desk. BSD stat and date on macOS, GNU on Linux.
pickable_folders() {
  local gnu=""; stat -c %W / >/dev/null 2>&1 && gnu=1
  { find "$best/projects" "$best/inbox" "$best/stash" "$best"/services/* -mindepth 1 -maxdepth 1 -type d
    echo "$best/desk"; } | while IFS= read -r dir; do
    if [ -n "$gnu" ]; then t="$(stat -c %W "$dir")"; d="$(date -d "@$t" +%F)"
    else t="$(stat -f %B "$dir")"; d="$(date -r "$t" +%F)"; fi
    echo "$d $t $dir"
  done
}

# Start an unsupervised claude -p session in $1 with instruction $2, detached from this terminal.
run_in_background() {
  local dir="$1" instruction="$2" logs="${XDG_STATE_HOME:-$HOME/.local/state}/proj/runs"
  mkdir -p "$logs"
  local log="$logs/$(date +%Y-%m-%d-%H%M%S)-$(basename "$dir").log"
  printf 'dir: %s\ninstruction: %s\n\n' "$dir" "$instruction" > "$log"
  (cd "$dir" && nohup claude -p --dangerously-skip-permissions "$instruction" </dev/null >>"$log" 2>&1 &)
  echo "Started claude in $dir" >&2
  echo "Log: $log" >&2
}

if [ -z "$name" ]; then
  [ -z "$agent$visibility" ] || usage
  command -v fzf >/dev/null || { echo "proj: picking a project needs fzf (brew install fzf)" >&2; exit 1; }
  # List paths relative to ~/best, newest first by the date in the folder name (month-only
  # folders count as day 00; undated folders use their creation date), then by creation time.
  # Typing ranks fuzzy matches; equal matches keep that order.
  out="$(pickable_folders | sed "s|$best/||" |
    awk '{ n = split($3, p, "/"); d = substr(p[n], 1, 10)
           if (d !~ /^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) d = (d ~ /^[0-9]{4}-[0-9]{2}-/) ? substr(d, 1, 7) "-00" : $1
           print d, $2, $3 }' |
    sort -k1,1r -k2,2nr | cut -d' ' -f3- |
    fzf --height=40% --reverse --scheme=path --tiebreak=index --prompt='project> ' \
      --expect=tab --header='enter: open  tab: give claude an instruction to run in the background')" || exit 1
  key="$(sed -n 1p <<<"$out")" picked="$(sed -n 2p <<<"$out")"
  if [ "$key" = tab ]; then
    printf 'instruction for claude in %s> ' "$picked" >&2
    IFS= read -r -e instruction </dev/tty
    [ -n "$instruction" ] || { echo "proj: empty instruction, nothing started" >&2; exit 1; }
    run_in_background "$best/$picked" "$instruction"
    exit 0
  fi
  echo "$best/$picked"
  exit 0
fi

case "$name" in
  */*) parent="$best/${name%/*}"; slug="${name##*/}" ;;
  *) parent="$best/projects"; slug="$name" ;;
esac
# Own projects are dated to the day; services, trials and inbox use the month.
date_format=%Y-%m
[ "$parent" = "$best/projects" ] && date_format=%Y-%m-%d
slug="$(printf '%s' "$slug" | tr '[:upper:] _' '[:lower:]--' | tr -cd 'a-z0-9-')"
[ -n "$slug" ] || { echo "proj: name must contain letters or digits" >&2; exit 2; }
# Client work under services/ is private; everything else is public unless told otherwise.
if [ -z "$visibility" ]; then
  case "$parent/" in
    "$best/services/"*) visibility=private ;;
    *) visibility=public ;;
  esac
fi

existing="$(find "$parent" -maxdepth 1 -type d \( -name "[0-9][0-9][0-9][0-9]-[0-9][0-9]-$slug" \
  -o -name "[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-$slug" \) 2>/dev/null | sort | tail -1)"
if [ -n "$existing" ]; then
  dir="$existing"
  echo "Reopening $dir"
  if url="$(git -C "$dir" remote get-url origin 2>/dev/null)"; then echo "${url%.git}"; fi
elif [ -d "$parent/template" ] && git -C "$parent" rev-parse -q --is-inside-work-tree >/dev/null 2>&1; then
  # A folder inside a repository with a template, such as projects/2026-10-08-trials/: copy it, no new repo.
  dir="$parent/$(date +"$date_format")-$slug"
  cp -R "$parent/template" "$dir"
  echo "Created $dir from template"
else
  dir="$parent/$(date +"$date_format")-$slug"
  if [ "$visibility" != local ]; then
    # Check the repo name before creating anything, so a taken name leaves no half-made folder.
    owner="$(gh api user --jq .login)"
    if out="$(gh api "repos/$owner/$slug" --jq .html_url 2>&1)"; then
      echo "proj: $out already exists; pick another name" >&2; exit 1
    elif ! grep -q "Not Found" <<<"$out"; then
      echo "proj: could not check GitHub: $out" >&2; exit 1
    fi
  fi
  mkdir -p "$dir"
  git -C "$dir" init -q -b main
  cat > "$dir/AGENTS.md" <<AGENTS
# $slug

Scope: TODO

- Visibility: $visibility
- Still running or billing: none
AGENTS
  git -C "$dir" add AGENTS.md
  git -C "$dir" commit -q -m "Start $slug"
  echo "Created $dir"
  if [ "$visibility" != local ]; then
    gh repo create "$owner/$slug" "--$visibility" --source "$dir" --push >/dev/null
    url="$(git -C "$dir" remote get-url origin)"
    echo "${url%.git}"
  fi
fi

cd "$dir"
case "$agent" in
  claude) exec claude --dangerously-skip-permissions ;;
  codex) exec codex --profile cli --dangerously-bypass-approvals-and-sandbox ;;
esac
