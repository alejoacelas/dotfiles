#!/usr/bin/env bash
# proj: create or reopen a dated project folder in ~/best and start an agent there.
# Usage: proj <name> [--claude|--codex]
#   proj                                         -> print the newest folder in ~/best/projects
#   proj morning-notes --claude                  -> ~/best/projects/YYYY-MM-DD-morning-notes
#   proj clients/impact-ops/status-tracker --codex -> ~/best/clients/impact-ops/YYYY-MM-status-tracker
#   proj inbox/odd-idea                          -> create only, print the path
# An existing folder whose name ends in -<name> is reopened instead of created.
# The proj shell function in shell/zprofile cds into the printed path when no name is given.
set -euo pipefail

usage() { sed -n '2,8s/^# \{0,1\}//p' "$0" >&2; exit 2; }

agent="" name=""
for arg in "$@"; do
  case "$arg" in
    --claude) agent=claude ;;
    --codex) agent=codex ;;
    -h|--help) usage ;;
    -*) echo "proj: unknown option $arg" >&2; usage ;;
    *) [ -z "$name" ] || usage; name="$arg" ;;
  esac
done
best="$HOME/best"

if [ -z "$name" ]; then
  [ -z "$agent" ] || usage
  # Newest dated folder in projects/ by creation time; BSD stat on macOS, GNU on Linux.
  birth=(-f '%B %N'); stat -c %W / >/dev/null 2>&1 && birth=(-c '%W %n')
  find "$best/projects" -mindepth 1 -maxdepth 1 -type d -name "[0-9][0-9][0-9][0-9]-[0-9][0-9]-*" \
      -exec stat "${birth[@]}" {} + |
    sort -n | tail -1 | cut -d' ' -f2-
  exit 0
fi

case "$name" in
  */*) parent="$best/${name%/*}"; slug="${name##*/}" ;;
  *) parent="$best/projects"; slug="$name" ;;
esac
# Own projects are dated to the day; clients, trials and inbox use the month.
date_format=%Y-%m
[ "$parent" = "$best/projects" ] && date_format=%Y-%m-%d
slug="$(printf '%s' "$slug" | tr '[:upper:] _' '[:lower:]--' | tr -cd 'a-z0-9-')"
[ -n "$slug" ] || { echo "proj: name must contain letters or digits" >&2; exit 2; }

existing="$(find "$parent" -maxdepth 1 -type d \( -name "[0-9][0-9][0-9][0-9]-[0-9][0-9]-$slug" \
  -o -name "[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-$slug" \) 2>/dev/null | sort | tail -1)"
if [ -n "$existing" ]; then
  dir="$existing"
  echo "Reopening $dir"
else
  dir="$parent/$(date +"$date_format")-$slug"
  if [ -d "$parent/template" ] && git -C "$parent" rev-parse -q --is-inside-work-tree >/dev/null 2>&1; then
    # A folder inside a repository with a template, such as projects/motif/trials/: copy it, no new repo.
    cp -R "$parent/template" "$dir"
    echo "Created $dir from template"
  else
    mkdir -p "$dir"
    git -C "$dir" init -q -b main
    cat > "$dir/AGENTS.md" <<EOF
# $slug

Scope: TODO

- Visibility: TODO
- Google account: TODO
- Still running or billing: none
EOF
    echo "Created $dir"
  fi
fi

cd "$dir"
case "$agent" in
  claude) exec claude --dangerously-skip-permissions ;;
  codex) exec codex --profile cli --dangerously-bypass-approvals-and-sandbox ;;
esac
