#!/usr/bin/env bash
# Mirror public project skills into the private repositories that use them.
set -euo pipefail

DOTFILES_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BEST_ROOT="$(cd "$DOTFILES_ROOT/.." && pwd)"
SOURCE_ROOT="$DOTFILES_ROOT/plugins/calls/skills"
RSYNC_ARGS=(-acO --delete --exclude=.env --exclude=.venv --exclude=data/ --exclude=__pycache__/)
stale=0

for project in calls writing/ai-guides; do
  if [ ! -d "$BEST_ROOT/$project/.git" ]; then
    printf 'skip: %s repo is not cloned\n' "$project"
    continue
  fi
  for source in "$SOURCE_ROOT"/*/; do
    skill="$(basename "$source")"
    if [ "$project" = writing/ai-guides ] && [ "$skill" != call-wiki ] && [ "$skill" != wiki-comments ]; then
      continue
    fi
    target="$BEST_ROOT/$project/.claude/skills/$skill/"
    if [ "${1:-}" = --check ]; then
      if [ ! -d "$target" ]; then
        printf '%s %s mirror is missing\n' "$project" "$skill" >&2
        stale=1
        continue
      fi
      changes="$(rsync -n --itemize-changes "${RSYNC_ARGS[@]}" "$source" "$target")"
      if [ -n "$changes" ]; then
        printf '%s %s mirror is stale:\n%s\n' "$project" "$skill" "$changes" >&2
        stale=1
      fi
      continue
    fi
    mkdir -p "$target"
    rsync "${RSYNC_ARGS[@]}" "$source" "$target"
    for local_path in .env .venv; do
      if [ -e "$source$local_path" ]; then
        if [ -L "$target$local_path" ]; then
          ln -sfn "$source$local_path" "$target$local_path"
        elif [ ! -e "$target$local_path" ]; then
          ln -s "$source$local_path" "$target$local_path"
        fi
      fi
    done
    printf 'synced: %s/%s\n' "$project" "$skill"
  done
done
if [ "$stale" -ne 0 ]; then
  printf 'Run %s/bin/sync-project-skills, then commit the affected repositories.\n' "$DOTFILES_ROOT" >&2
  exit 1
fi
if [ "${1:-}" = --check ]; then
  printf 'ok: project skill mirrors match dotfiles\n'
fi
