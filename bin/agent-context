#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = []
# ///
"""Read-only session context from explicitly selected project groups."""
from __future__ import annotations
import argparse
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile
import time

DOTFILES = Path(__file__).resolve().parents[1]
STATE = Path.home() / '.local/state/agent-context'
NAME = re.compile(r'[a-z0-9][a-z0-9-]*\Z')
EXCLUDED = {'archive', 'archives', 'fixtures', 'test-fixtures', 'vendor', 'vendors',
            'node_modules', '.venv', 'venv', 'snapshots', 'original-containers', 'retired-upcoming'}


def digest(data):
    return hashlib.sha256(data.encode()).hexdigest()


def atomic(path, content, before=None):
    """Compare immediately before replacing; refuse symlink outputs."""
    if path.is_symlink():
        raise ValueError(f'{path}: output is a symlink; adopt the real file explicitly')
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temp = tempfile.mkstemp(prefix='.' + path.name + '.', dir=path.parent)
    try:
        with os.fdopen(fd, 'w') as f:
            f.write(content)
            f.flush()
            os.fsync(f.fileno())
        if path.exists():
            os.chmod(temp, path.stat().st_mode & 0o777)
        if before is not None and (not path.exists() or path.read_text() != before):
            raise ValueError(f'{path}: changed during sync; retry next session')
        os.replace(temp, path)
    finally:
        if os.path.exists(temp):
            os.unlink(temp)


def registry_paths():
    return [DOTFILES / 'agents/projects.json',
            Path.home() / '.local/share/agent-context/private/projects.json']


def validate(config):
    if not isinstance(config, dict):
        raise ValueError('Project selection must be an object')
    groups = config.get('groups')
    if (not isinstance(groups, list) or not all(isinstance(x, str) and NAME.fullmatch(x) for x in groups)
            or len(groups) != len(set(groups))):
        raise ValueError('Groups must be unique lowercase names')
    if config.get('visibility') not in ('public', 'private'):
        raise ValueError('Project visibility must be public or private')


def load_projects():
    projects = {}
    for registry in registry_paths():
        if not registry.exists():
            continue
        data = json.loads(registry.read_text())
        if data.get('version') != 1 or not isinstance(data.get('projects'), dict):
            raise ValueError(f'{registry}: expected version 1 and projects object')
        for name, config in data['projects'].items():
            path = Path(name).expanduser()
            if not path.is_absolute():
                raise ValueError(f'{registry}: project paths must be absolute or start with ~/')
            path = path.resolve()
            validate(config)
            if path in projects:
                raise ValueError(f'Duplicate project selection: {path}')
            if registry == registry_paths()[0] and config['visibility'] != 'public':
                raise ValueError(f'{registry}: private projects belong in the private registry')
            projects[path] = config
    return projects


def locate(cwd, projects):
    """Only explicit selections within this checkout; never inherit across a nested repo."""
    cwd = cwd.resolve()
    if EXCLUDED.intersection(cwd.parts):
        return None
    for root in [cwd, *cwd.parents]:
        if root in projects:
            return root
        if (root / '.git').exists():
            # Linked worktrees share their main checkout's explicit selection.
            if (root / '.git').is_file():
                common = subprocess.check_output(
                    ['git', '-C', str(root), 'rev-parse', '--path-format=absolute', '--git-common-dir'],
                    text=True, timeout=5).strip()
                original = Path(common).resolve().parent
                relative = cwd.relative_to(root)
                for suffix in [relative, *relative.parents]:
                    candidate = original / suffix
                    if candidate in projects:
                        return candidate
            break
    return None


def local_only_paths():
    """Known container instructions: load in their own scope, never across repositories."""
    paths = []
    for registry in registry_paths():
        if registry.exists():
            for name in json.loads(registry.read_text()).get('local_only', []):
                path = Path(name).expanduser()
                if not path.is_absolute() or path.name != 'AGENTS.md':
                    raise ValueError(f'{registry}: local_only entries must be absolute AGENTS.md paths')
                paths.append(path)
    return paths


def local_context(cwd):
    # Claude excludes these exact files globally; restore only this checkout's own scope.
    cwd = cwd.resolve()
    excluded = {p.resolve() for p in local_only_paths()}
    pieces = []
    for root in [cwd, *cwd.parents]:
        path = root / 'AGENTS.md'
        if path.resolve() in excluded and path.is_file():
            pieces.append(f'Local instructions from {path}:\n{path.read_text().strip()}')
        if (root / '.git').exists():
            break
        # Outside Git, only the starting directory is local, not every ancestor.
        if root == cwd and not any((p / '.git').exists() for p in cwd.parents):
            break
    return '\n\n'.join(reversed(pieces))


def group_text(config):
    validate(config)
    pieces = []
    for group in config['groups']:
        public = DOTFILES / 'agents/groups' / (group + '.md')
        private = Path.home() / '.local/share/agent-context/private/groups' / (group + '.md')
        if public.exists() and private.exists():
            raise ValueError(f'Ambiguous public and private group: {group}')
        source = public if public.exists() else private
        if not source.is_file():
            raise ValueError(f'Missing shared group: {group}')
        if source == private and config['visibility'] != 'private':
            raise ValueError(f'Private group {group} requires a private project')
        pieces.append(f'Shared group: {group} (source: {source})\n{source.read_text().strip()}')
    text = '\n\n'.join(pieces)
    if len(text.encode()) > 24000:
        raise ValueError('Shared context exceeds 24 KB; reduce the groups')
    return text


def shared_context(cwd):
    projects = load_projects()
    selected = locate(cwd, projects)
    if selected is None:
        return ''
    text = group_text(projects[selected])
    if not text:
        return ''
    return (f'Explicit shared instructions for {selected}. These are project defaults; '
            'more specific project instructions take precedence. Relative paths in a source '
            'are relative to that source file.\n\n' + text)


def adopt(path, groups, visibility):
    """Register a deliberate choice without changing the project's instructions."""
    path = (path.parent if path.name == 'AGENTS.md' else path).resolve()
    if not path.is_dir():
        raise ValueError(f'Project directory does not exist: {path}')
    config = {'groups': groups, 'visibility': visibility}
    group_text(config)  # Validate before writing.
    registries = registry_paths()
    destination = registries[0 if visibility == 'public' else 1]
    projects = load_projects()
    if path in projects and projects[path]['visibility'] != visibility:
        raise ValueError('Visibility change requires moving the existing registry entry explicitly')
    old = destination.read_text() if destination.exists() else None
    data = json.loads(old) if old is not None else {'version': 1, 'projects': {}}
    key = str(path)
    if path.is_relative_to(Path.home()):
        key = '~/' + str(path.relative_to(Path.home()))
    # Normalize existing spelling, including absolute versus home-relative paths.
    data['projects'] = {k: v for k, v in data['projects'].items()
                        if Path(k).expanduser().resolve() != path}
    if groups:
        data['projects'][key] = config
    data['projects'] = dict(sorted(data['projects'].items()))
    atomic(destination, json.dumps(data, indent=2) + '\n', old)


def trust_codex_hook(home, command):
    """Trust only this installer's exact handler through Codex's config API."""
    import queue
    import threading
    env = os.environ.copy()
    env['CODEX_HOME'] = str(home)
    proc = subprocess.Popen(['codex', 'app-server', '--listen', 'stdio://'],
                            stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                            stderr=subprocess.DEVNULL, text=True, env=env)
    messages = queue.Queue()
    def read():
        for line in proc.stdout:
            try:
                messages.put(json.loads(line))
            except ValueError:
                pass
    threading.Thread(target=read, daemon=True).start()
    serial = 0
    def rpc(method, params):
        nonlocal serial
        serial += 1
        proc.stdin.write(json.dumps({'id': serial, 'method': method, 'params': params}) + '\n')
        proc.stdin.flush()
        while True:
            result = messages.get(timeout=20)
            if result.get('id') == serial:
                if 'error' in result:
                    raise ValueError(str(result['error']))
                return result['result']
    try:
        rpc('initialize', {'clientInfo': {'name': 'agent_context_installer', 'version': '1'},
                           'capabilities': {'experimentalApi': True}})
        proc.stdin.write('{"method":"initialized"}\n')
        proc.stdin.flush()
        listing = rpc('hooks/list', {'cwds': [str(DOTFILES)]})
        owned = [h for entry in listing['data'] for h in entry['hooks']
                 if h.get('command') == command and h.get('eventName') == 'sessionStart'
                 and h.get('source') == 'user' and Path(h['sourcePath']) == home / 'hooks.json']
        if len(owned) != 1:
            raise ValueError(f'{home}: expected exactly one owned SessionStart hook')
        hook = owned[0]
        if hook['trustStatus'] != 'trusted' or not hook['enabled']:
            config = home / 'config.toml'
            if config.exists():
                atomic(STATE / 'config-backups' / (digest(str(config) + config.read_text()) + '.toml'), config.read_text())
            rpc('config/value/write', {'keyPath': 'hooks.state.' + json.dumps(hook['key']),
                'value': {'enabled': True, 'trusted_hash': hook['currentHash']}, 'mergeStrategy': 'upsert'})
        print(f'Trusted only the installed context hook: {home}')
    finally:
        proc.terminate()
        proc.wait(timeout=10)


def claude_exclusions(data, target):
    """Reconcile only exclusions this installer owns, retaining independent choices."""
    state = STATE / ('claude-exclusions-' + digest(str(target)) + '.json')
    desired = list(dict.fromkeys(name for path in local_only_paths()
                                for name in (str(path), str(path.resolve()))))
    # A fresh clone may already contain these generated exclusions in settings.json.
    owned = json.loads(state.read_text()) if state.exists() else desired
    independent = [name for name in data.get('claudeMdExcludes', []) if name not in owned]
    data['claudeMdExcludes'] = independent + [name for name in desired if name not in independent]
    return state, [name for name in desired if name not in independent]


def install():
    """Merge one owned hook into existing configs, including Orca account homes."""
    import shlex
    base_command = shlex.quote(sys.executable) + ' ' + shlex.quote(str(DOTFILES / 'bin/agent-context')) + ' hook'
    homes = [Path.home() / '.codex']
    homes += list((Path.home() / 'Library/Application Support/orca/codex-accounts').glob('*/home'))
    if os.environ.get('CODEX_HOME'):
        homes.append(Path(os.environ['CODEX_HOME']))
    configs = [(Path.home() / '.claude/settings.json', False)]
    configs += [(h / 'hooks.json', True) for h in homes]
    configs += [(DOTFILES / 'codex/hooks.json', True), (DOTFILES / 'claude/settings.json', False)]
    seen = set()
    for config, codex in configs:
        target = config.resolve()
        if target in seen:
            continue
        seen.add(target)
        old = target.read_text() if target.exists() else '{}'
        data = json.loads(old)
        command = base_command + (' --client codex' if codex else ' --client claude')
        exclusion_state = claude_exclusions(data, target) if not codex else None
        hooks = data.setdefault('hooks', {})
        for event, groups in list(hooks.items()):
            retained = []
            for group in groups:
                handlers = [h for h in group.get('hooks', []) if
                            'human_edit_hook.py' not in h.get('command', '') and
                            '/bin/agent-context' not in h.get('command', '')]
                if handlers:
                    retained.append(dict(group, hooks=handlers))
            hooks[event] = retained
        handler = {'type': 'command', 'command': command, 'timeout': 30}
        if codex:
            handler['additionalContextLimit'] = 30000
        hooks.setdefault('SessionStart', []).append({'hooks': [handler]})
        text = json.dumps(data, indent=2) + '\n'
        if text != old:
            backup = STATE / 'config-backups' / (digest(str(target) + old) + '.json')
            if not backup.exists():
                atomic(backup, old)
            atomic(target, text, old if target.exists() else None)
        if exclusion_state:
            state, owned = exclusion_state
            atomic(state, json.dumps(owned, indent=2) + '\n')
        print(f'Installed SessionStart hook: {config}')
    for home in set(homes):
        home.mkdir(parents=True, exist_ok=True)
        target = home / 'AGENTS.md'
        source = DOTFILES / 'agents/AGENTS.md'
        if target.is_symlink() and target.resolve() == source:
            continue
        if target.exists() or target.is_symlink():
            backup = STATE / 'config-backups' / ('AGENTS-' + digest(str(target)))
            if backup.exists():
                raise ValueError(f'Existing backup prevents replacing {target}')
            target.rename(backup)
        target.symlink_to(source)
    for home in set(homes):
        trust_codex_hook(home, base_command + ' --client codex')


def live_project_reminder(cwd):
    """Report stale live projects; never move a checkout from a startup hook."""
    projects = (DOTFILES.parent / 'projects').resolve()
    cwd = cwd.resolve()
    if cwd != projects.parent and not cwd.is_relative_to(projects):
        return ''
    live = projects / 'live'
    if not live.is_dir():
        return ''
    now = time.time()
    notes = []
    metadata = {'AGENTS.md', 'CLAUDE.md', 'REPLICATE.md', '.gitignore', '.DS_Store'}
    specs = ['.', *[f':(exclude,glob)**/{name}' for name in sorted(metadata)]]
    for project in sorted(live.iterdir()):
        if not project.is_dir() or project.name.startswith('.') or project.is_symlink():
            continue
        if not (project / '.git').exists():
            notes.append(f'- {project.name}: no Git repository; inspect activity manually.')
            continue
        def git(*args):
            return subprocess.check_output(['git', '-C', str(project), *args], timeout=5).decode()
        stamp = git('log', '-1', '--format=%ct', '--', *specs).strip()
        latest = float(stamp) if stamp else 0
        changed = git('diff', '--name-only', '-z', 'HEAD', '--', *specs)
        changed += git('ls-files', '--others', '--exclude-standard', '-z', '--', *specs)
        for name in changed.split('\0'):
            file = project / name
            if name and file.is_file() and not file.is_symlink():
                latest = max(latest, file.stat().st_mtime)
        if not latest:
            notes.append(f'- {project.name}: no substantive activity found; review its destination.')
        elif now - latest >= 14 * 86400:
            notes.append(f'- {project.name}: {int((now - latest) // 86400)} days since substantive activity.')
    if not notes:
        return ''
    return ('Live project review: follow projects/AGENTS.md and move inactive projects out of live/ '
            'to a topic folder or durable destination. Review uncommitted work and running sessions first. '
            'The hook only reports candidates.\n' + '\n'.join(notes))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('command', choices=['hook', 'check', 'adopt', 'install'])
    parser.add_argument('path', nargs='?', default='.')
    parser.add_argument('--groups', nargs='*', default=[])
    parser.add_argument('--client', choices=['codex', 'claude'], default='codex')
    parser.add_argument('--visibility', choices=['public', 'private'], default='public')
    args = parser.parse_args()
    if args.command == 'install':
        install()
        return 0
    payload = json.load(sys.stdin) if args.command == 'hook' else {}
    if args.command == 'hook' and payload.get('hook_event_name', 'SessionStart') != 'SessionStart':
        return 0
    cwd = Path(payload.get('cwd', args.path)).expanduser().resolve()
    if cwd.name == 'AGENTS.md':
        cwd = cwd.parent
    if args.command == 'adopt':
        STATE.mkdir(parents=True, exist_ok=True)
        os.chmod(STATE, 0o700)
        with (STATE / 'registry.lock').open('w') as handle:
            fcntl.flock(handle, fcntl.LOCK_EX)
            adopt(cwd, args.groups, args.visibility)
        print(f'Selected {cwd}: {", ".join(args.groups) or "no shared groups"}')
        return 0
    context = shared_context(cwd)
    if args.command == 'check':
        print(context or 'No shared groups selected')
        return 0
    reminder = live_project_reminder(cwd)
    local = local_context(cwd) if args.client == 'claude' else ''
    context = '\n\n'.join(part for part in [local, context, reminder] if part)
    if context:
        print(json.dumps({'hookSpecificOutput': {
            'hookEventName': 'SessionStart', 'additionalContext': context}}))
    return 0


if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except Exception as exc:
        message = f'Agent context failed: {exc}'
        STATE.mkdir(parents=True, exist_ok=True)
        with (STATE / 'errors.log').open('a') as log:
            log.write(message + '\n')
        print(message, file=sys.stderr)
        if len(sys.argv) > 1 and sys.argv[1] == 'hook':
            print(json.dumps({'systemMessage': message, 'hookSpecificOutput': {
                'hookEventName': 'SessionStart', 'additionalContext': message + '. Shared instructions were not loaded; resolve before relying on them.'}}))
        raise SystemExit(1)
