# Umi attention config, from dotfiles (umi/umi.config). Included by ~/.config/umi/config.
# Palette commands are the scripts in umi/commands/, linked to ~/.config/umi/commands/.

# ⌃⌘H: hide this pane until its agent's turn ends.
key.ctrl+cmd+h = Hide until turn ends
# ⌃⌘E: hand this pane to the manager pane.
key.ctrl+cmd+e = Delegate to manager

# Panes the manager couldn't settle come first in ⌃⌘J.
list.escalated = escalated=true | sort changed_at
list.jump = @escalated then @needs-you then @unseen
