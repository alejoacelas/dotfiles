#!/bin/bash
# Rebuild the day timeline from this Mac's activity and copy it to the agent server, which serves it at
# https://agent-server.tail622085.ts.net/day (tailnet only). Run by launchd every hour; safe to run by hand.
# First pulls dotfiles and clerk (bin/pull-agent-repos), so pushed fixes to Mac scripts arrive within the hour.
# Also copies the last 3 days of Chrome history (chrome_export.py) to /srv/agent-share/chrome-history/ on the
# server, for clerk's desk-links job; a failure there doesn't stop the timeline.
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
"$here/../../../bin/pull-agent-repos" || true
python3 "$here/build.py" --days 14 --no-open
ssh agent-server 'mkdir -p ~/.local/share/day-timeline'
scp -q "$HOME/.local/share/day/timeline/index.html" agent-server:.local/share/day-timeline/index.html.new
ssh agent-server 'mv ~/.local/share/day-timeline/index.html.new ~/.local/share/day-timeline/index.html'
date -u +"%Y-%m-%dT%H:%M:%SZ published"
tmp="$(mktemp)"
python3 "$here/chrome_export.py" --days 3 > "$tmp" \
  && scp -q "$tmp" agent-server:/srv/agent-share/chrome-history/visits.json.new \
  && ssh agent-server 'chmod 640 /srv/agent-share/chrome-history/visits.json.new && mv /srv/agent-share/chrome-history/visits.json.new /srv/agent-share/chrome-history/visits.json' \
  && date -u +"%Y-%m-%dT%H:%M:%SZ chrome history copied" \
  || echo "chrome history copy failed" >&2
rm -f "$tmp"
