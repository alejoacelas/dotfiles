{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 36500,
  "env": {
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:8787/t/11d8c38b7eee9c20c5ba9d2a5ccaee14",
    "_CLAUDE_CODE_ASSUME_FIRST_PARTY_BASE_URL": "1",
    "ENABLE_TOOL_SEARCH": "true",
    "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "258400",
    "ANTHROPIC_CUSTOM_MODEL_OPTION": "gpt-5.6-sol",
    "ANTHROPIC_CUSTOM_MODEL_OPTION_NAME": "GPT-5.6 Sol"
  },
  "permissions": {
    "allow": [
      "Bash(brew install:*)",
      "Bash(brew update:*)",
      "Bash(brew upgrade:*)",
      "Bash(brew info:*)",
      "Bash(brew search:*)",
      "Bash(brew list:*)",
      "Bash(brew link:*)",
      "Bash(brew unlink:*)",
      "Bash(brew tap:*)",
      "Bash(brew --prefix:*)",
      "Bash(uv:*)",
      "Bash(uvx:*)",
      "Bash(node:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(pnpm:*)",
      "Bash(yarn:*)",
      "Bash(corepack:*)",
      "Bash(cargo:*)",
      "Bash(rustup:*)",
      "Bash(rustc:*)",
      "Bash(python3:*)",
      "Bash(pip3:*)",
      "Bash(pip:*)",
      "Bash(gh:*)",
      "Bash(codex-companion)",
      "Bash(codex-companion help)",
      "Bash(codex-companion help *)",
      "Bash(codex-companion review)",
      "Bash(codex-companion review *)",
      "Bash(codex-companion adversarial-review)",
      "Bash(codex-companion adversarial-review *)",
      "Bash(codex-companion plan-review *)",
      "Bash(codex-companion status)",
      "Bash(codex-companion status *)",
      "Bash(codex-companion result)",
      "Bash(codex-companion result *)",
      "Bash(codex-companion cancel)",
      "Bash(codex-companion cancel *)"
    ],
    "defaultMode": "auto"
  },
  "skillOverrides": {
    "anthropic-skills:summarise-granola": "off",
    "summarise-granola": "off",
    "resolve-denied-toolcall": "off"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/best/stash/dotfiles/claude/hooks/relink-settings.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/best/stash/dotfiles/claude/hooks/quiet-plugin-hooks.py\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "vercel@claude-plugins-official": false,
    "codex@codex-plugin-cc": false,
    "warp@claude-code-warp": false,
    "airtable@anthropic-plugin-directory": true,
    "umi@umi": true
  },
  "extraKnownMarketplaces": {
    "codex-plugin-cc": {
      "source": {
        "source": "github",
        "repo": "Crazytieguy/codex-plugin-cc"
      },
      "autoUpdate": true
    },
    "alignment-hive": {
      "source": {
        "source": "github",
        "repo": "Crazytieguy/alignment-hive"
      }
    },
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    },
    "umi": {
      "source": {
        "source": "directory",
        "path": "/Applications/Umi.app/Contents/Resources/agent-plugins"
      }
    }
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-sonnet-5": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "remote": {
    "defaultEnvironmentId": "env_019kvNdUFTaAbmz1F44nmPSN"
  },
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "switchModelsOnFlag": true,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true
}
